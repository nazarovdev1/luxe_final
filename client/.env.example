# React Client Environment Variables
# In production, set these variables in Vercel Dashboard -> Project Settings -> Environment Variables

# The URL of the backend Express API (e.g., https://api.luxx.uz/api)
REACT_APP_API_URL=https://api.luxx.uz/api

# The URL of the socket.io server (e.g., https://api.luxx.uz)
REACT_APP_SOCKET_URL=https://api.luxx.uz

# ImageKit public key for client-side uploads (if applicable)
REACT_APP_IMAGEKIT_PUBLIC_KEY=public_mnemyo/d2OAPyIzzxUa3mXisNc0=
